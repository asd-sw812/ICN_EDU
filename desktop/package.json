{
  "name": "icn-edu-offline",
  "version": "1.0.0",
  "description": "The Endless Archive offline school exhibition game",
  "author": "asd-sw812",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-site": "node prepare.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "school.icn.edu.endlessarchive",
    "productName": "The Endless Archive",
    "asar": true,
    "files": ["main.cjs", "package.json"],
    "extraResources": [{"from": "site", "to": "site", "filter": ["**/*"]}],
    "directories": {"output": "dist"},
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "signAndEditExecutable": false,
      "artifactName": "ICN_EDU-Offline-Windows-x64.exe"
    },
    "portable": {"requestExecutionLevel": "user"}
  }
}
