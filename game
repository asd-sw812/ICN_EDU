function addBuff(u,key,val,dur=2){
 if(DAMAGE_PREVIEW){
  DAMAGE_PREVIEW.effects.push({targetId:u.id,targetIndex:u.index,targetSide:u.side,key,val,dur});
 }
 const effect=u.buffs[key]||{v:0,d:0,stacks:0};
 const oldStacks=effect.stacks||0,newStacks=Math.min(EFFECT_MAX_STACKS,oldStacks+1);
 if(oldStacks<EFFECT_MAX_STACKS)effect.v=Math.min(EFFECT_VALUE_CAPS[key]??Infinity,effect.v+val);
 effect.d=dur>=99||effect.d>=99?99:Math.min(EFFECT_MAX_DURATION,effect.d+dur);
 effect.stacks=newStacks;
 if(state&&current()&&current().id===u.id)effect.skipTick=true;
 u.buffs[key]=effect;
 VFX.event("buff",u,0,{negative:key.endsWith("Down")||key==="vulnerable"});
 if(state&&state.deckId==="speed"&&u.side==="player"&&key==="speedUp"){const navigator=state.players[2];if(navigator&&!navigator.dead&&navigator!==u)resGain(navigator,1)}
}
function buff(u,key){return u.buffs[key]?.v||0}
function effDef(u,type="reality"){const base=type==="mental"?u.mdef:u.pdef,treeBonus=state&&state.deckId==="tree"&&u.side==="player"&&u.index===3?(state.shared?.tree||0)*.10:0;return Math.max(0,base*(1+treeBonus+buff(u,"defUp")/100-buff(u,"defDown")/100))}
function effAtk(u){const treeBonus=state&&state.deckId==="tree"&&u.side==="player"&&u.index===0?(state.shared?.tree||0)*.12:0;return Math.max(1,u.atk*(1+treeBonus+buff(u,"atkUp")/100-buff(u,"atkDown")/100))}
function effSpeed(u){
