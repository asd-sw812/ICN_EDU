function addTaunt(t,count=1){
 if(!t||t.dead||t.side!=="player")return 0;
 if(DAMAGE_PREVIEW)DAMAGE_PREVIEW.taunts.push({targetId:t.id,targetIndex:t.index,count:Math.max(1,Math.round(count))});
 t.taunt=(t.taunt||0)+Math.max(1,Math.round(count));
 log(`${unitLabel(t)} [도발] ${t.taunt}회.`);return t.taunt
}

function takeDamage(target,amount,source=null,flags={}){
 amount=Math.max(0,Math.round(amount));
 if(DAMAGE_PREVIEW&&target.side==="enemy"&&(flags.playerEffect||(source&&source.side==="player"))){
   const weight=DAMAGE_PREVIEW.weight==null?1:DAMAGE_PREVIEW.weight;
   DAMAGE_PREVIEW.fixedDamage+=amount*weight;
   if(state&&state.actionContext)state.actionContext.didDamage=amount>0;
   return 0
 }
 if(source&&source.side==="enemy"&&target.side==="player")amount=Math.round(amount*BOSS_OUTGOING_DAMAGE_SCALE);
 if(source&&source.side==="enemy"&&target.side==="player"&&state&&state.deckId==="wind"&&(state.shared?.wind||0)>=15)amount=Math.round(amount*.88);
 const playerEffect=!!flags.playerEffect||(source&&source.side==="player");
 const oldShield=target.shield;
 const groggyHit=target.side==="enemy"&&target.staggered&&playerEffect;
 if(groggyHit)amount=Math.round(amount*target.staggerMultiplier);
 if(target.side==="enemy"&&playerEffect&&flags.limitPlayerDamage){
   amount=clamp(amount,flags.minDamage??0,PLAYER_DAMAGE_CAP);
 }

 const shieldUsed=Math.min(target.shield,amount);target.shield-=shieldUsed;if(target.shield<=0&&"shieldCap" in target)target.shieldCap=0;amount-=shieldUsed;
 const hpLost=Math.min(target.hp,amount);target.hp-=hpLost;
 const applied=shieldUsed+hpLost;
 if(applied>0)VFX.event("damage",target,applied,{shield:shieldUsed,crit:!!flags.crit,dot:!!flags.dot});

 if(target.side==="player"&&state.deckId==="defense"){
   if(target.resourceLabel==="축적 피해")resGain(target,Math.round(hpLost*.8));
   else resGain(target,1);
 }
 if(target.side==="player"&&state.deckId==="counter"){
   if(target.resourceLabel==="저장 피해")resGain(target,Math.round(hpLost*.6));
   else if(target.resourceLabel==="기록 피해")resGain(target,Math.round(hpLost*.8));
   else resGain(target,1);
 }

 if(target.hp<=0&&target.preventDeath>0){target.preventDeath--;target.hp=1;log(`${unitLabel(target)} 사망 방지.`)}
 else if(target.hp<=0){target.hp=0;target.dead=true;log(`${unitLabel(target)} 쓰러짐.`)}

 if(target.side==="player"&&hpLost>0)passiveOnDamage(target,hpLost);

 if(target.side==="enemy"&&playerEffect&&applied>0){
   const scoreDamage=state.mode==="raid"?hpLost:applied;
   const staggerDamage=flags.dot?applied*DOT_STAGGER_RATE:applied;
   registerBossDamage(scoreDamage,staggerDamage);
   bossSpecialOnPlayerHit(applied,source,oldShield);
   showDamagePop(applied,{crit:!!flags.crit,groggy:groggyHit,dot:!!flags.dot});
 }

 if(source&&source.side==="enemy"&&target.side==="player"&&applied>0){
   if(oldShield>0&&!target.dead&&state.deckId==="freeze"&&target.index===3)addChill(1);
   if(oldShield>0&&!target.dead&&state.deckId==="electric"&&target.index===3)resGain(target,1);
   if(target.counterReady>0&&!state.boss.dead){
     const cd=Math.max(15,Math.round(effDef(target,"reality")*.75+effAtk(target)*.4+target.counterReady));
     target.counterReady=0;
     const counterDamage=takePlayerEffectDamageDetailed(state.boss,cd,target);
     log(`${unitLabel(target)} [반격] ${damageResultText(counterDamage)}.`);
     if(state.deckId==="counter"&&target.index===0)addBuff(target,"defUp",5,3);
     const counterSupport=support1();
     if(state.deckId==="counter"&&counterSupport&&!counterSupport.dead){
       damage(counterSupport,state.boss,32,{type:"reality",attackRatio:.35,defenseWeight:.35});
       resGain(counterSupport,1);
     }
   }
   if(state.deckId==="counter"&&target.index===3&&oldShield>0&&target.shield===0&&!target.dead){addShield(target,8,target);log(`${unitLabel(target)} 패시브: 최대 체력 8% 보호막 재생.`)}
   if(state.deckId==="crit"&&target.index===3&&flags.crit&&oldShield>0&&!target.dead)resGain(target,1);
   if(state.deckId==="debuff"&&bossDebuffCount()>0){const echo=tank();if(echo&&!echo.dead)resGain(echo,1)}
   if(hpLost>0&&state.deckId==="lifesteal"){const medic=tank();if(medic&&!medic.dead&&!medic.passiveFlag&&target.hp>0&&target.hp/target.maxHp<=.3){medic.passiveFlag=true;const h=heal(target,150);log(`${unitLabel(medic)} 패시브 긴급 회복 ${h}.`)}}
   if(target.bleedThorn>0){addBleed(1);target.bleedThorn--;if(state.deckId==="bleed"&&target.index===3)resGain(target,1);log(`${unitLabel(target)} 피격 반응 → 보스 [출혈]+1.`)}
 }
 return hpLost
}
function takePlayerEffectDamage(target,amount,source=null,flags={}){
 if(DAMAGE_PREVIEW&&target&&target.side==="enemy"){
   const weight=DAMAGE_PREVIEW.weight==null?1:DAMAGE_PREVIEW.weight;
   DAMAGE_PREVIEW.effectCoefficient+=Math.max(0,amount)*PLAYER_EFFECT_ATK_SCALE*weight;
   DAMAGE_PREVIEW.effectHits++;
   if(state&&state.actionContext)state.actionContext.didDamage=amount>0;
   return 0
 }
 const living=state?alivePlayers():[],averageAtk=living.length?living.reduce((n,p)=>n+effAtk(p),0)/living.length:1000;
 const sourceAtk=source&&source.side==="player"?effAtk(source):averageAtk;
 const scaled=sourceAtk*(amount/100)*PLAYER_EFFECT_ATK_SCALE;
 return takeDamage(target,scaled,source,{...flags,playerEffect:true,limitPlayerDamage:true,minDamage:flags.minDamage??PLAYER_DAMAGE_MIN})
}
function takePlayerEffectDamageDetailed(target,amount,source=null,flags={}){
 const shieldBefore=target&&target.shield||0,hp=takePlayerEffectDamage(target,amount,source,flags),shield=Math.max(0,shieldBefore-(target&&target.shield||0));
 return {hp,shield,total:hp+shield}
}
function damageResultText(result){return `${result.total.toLocaleString()} 피해${result.shield?` (보호막 ${result.shield.toLocaleString()}${result.hp?` · 체력 ${result.hp.toLocaleString()}`:""})`:""}`}
function heal(t,n){
 if(!t||t.dead)return 0;
 if(t.side==="player"){n*=PLAYER_SUPPORT_SCALE*1.15;if(state&&state.deckId==="tree"&&t.index===3)n*=1+(state.shared?.tree||0)*.10}
 const potential=Math.max(0,Math.round(n));
 if(DAMAGE_PREVIEW){
  DAMAGE_PREVIEW.heals.push({targetId:t.id,targetIndex:t.index,targetSide:t.side,amount:potential});
  if(state&&state.actionContext)state.actionContext.healDone+=potential;
  return potential
 }
 const o=t.hp;t.hp=Math.min(t.maxHp,t.hp+potential);const h=t.hp-o;if(state&&state.actionContext)state.actionContext.healDone+=h;
 if(h>0)VFX.event("heal",t,h);return h
}
function partyHeal(n){alivePlayers().forEach(p=>heal(p,n))}
function addShield(t,percent,source=t){
 if(!t||t.dead||!source)return 0;
 const amount=Math.max(0,Math.round(source.maxHp*Math.max(0,percent)/100));
 if(DAMAGE_PREVIEW)DAMAGE_PREVIEW.shields.push({targetId:t.id,targetIndex:t.index,targetSide:t.side,sourceId:source.id,percent:Math.max(0,percent),amount});
 const sourceCap=Math.max(0,Math.round(source.maxHp*SHIELD_CAP_CASTER_HP_MULTIPLIER));
 const old=t.shield;
 t.shieldCap=Math.max(old,sourceCap);
 t.shield=Math.min(t.shieldCap,t.shield+amount);
 if(t.shield>old)VFX.event("shield",t,t.shield-old);
 return t.shield-old
}
function bossDebuffCount(){return ["atkDown","defDown","speedDown","vulnerable"].filter(k=>buff(state.boss,k)>0).length+(state.boss.frozen?1:0)+(state.boss.paralyzed?1:0)}
function addBossDebuff(k,v,d=2){const existed=buff(state.boss,k)>0;addBuff(state.boss,k,v,d);if(state&&state.actionContext){state.actionContext.newDebuff=!existed;state.actionContext.defDownApplied=state.actionContext.defDownApplied||k==="defDown";state.actionContext.vulnerableApplied=state.actionContext.vulnerableApplied||k==="vulnerable"}}
function damage(a,t,base,opt={}){
 if(!a||!t||a.dead||t.dead)return 0;
 const type=opt.type||a.attackType||(a.side==="player"?(deck().damage==="정신피해"?"mental":"reality"):"reality");
 if(t.side==="player"&&t.evade>0){
   t.evade--;
   if(state.deckId==="speed"){resGain(t,1);if(t.index===3)addShield(t,3,t)}
   log(`${unitLabel(t)} [회피].`);
   VFX.event("evade",t);
   return 0
 }
 const pen=clamp(opt.pen||0,0,.9);
 const atkRatio=opt.attackRatio==null?1:opt.attackRatio;
 const defenseWeight=opt.defenseWeight==null?1:opt.defenseWeight;
 const skillIndex=a.side==="player"?(opt.damageTier??(state&&state.actionContext?state.actionContext.skillIndex:null)):null;
 let tierScale=a.side==="player"?(skillIndex==null?PLAYER_EFFECT_ATK_SCALE:PLAYER_SKILL_ATK_SCALE[skillIndex]):1;
 if(a.side==="player"&&state.deckId==="wave"&&skillIndex===2&&state.actionContext)tierScale*=state.actionContext.waveMultiplier||1;
 const attackCoefficient=base*atkRatio*tierScale;
 if(DAMAGE_PREVIEW&&a.side==="player"&&t.side==="enemy"){
   const weight=DAMAGE_PREVIEW.weight==null?1:DAMAGE_PREVIEW.weight;
   DAMAGE_PREVIEW.attackCoefficient+=attackCoefficient*weight;
   DAMAGE_PREVIEW.defCoefficient+=(opt.defScale||0)*tierScale*100*weight;
   DAMAGE_PREVIEW.speedCoefficient+=(opt.speedScale||0)*tierScale*100*weight;
   let previewHpScale=opt.hpScale||0;
   if(state.deckId==="hp")previewHpScale*=.75;
   DAMAGE_PREVIEW.hpCoefficient+=previewHpScale*tierScale*100*weight;
   DAMAGE_PREVIEW.conditionCoefficient+=Math.max(0,opt.bonus||0)*tierScale/Math.max(1,effAtk(a))*100*weight;
   DAMAGE_PREVIEW.attackHits++;
   if(!DAMAGE_PREVIEW.types.includes(type))DAMAGE_PREVIEW.types.push(type);
   if(state&&state.actionContext){state.actionContext.didDamage=true;state.actionContext.critOccurred=state.actionContext.critOccurred||!!opt.forceCrit}
   return 0
 }
 let raw=effAtk(a)*(attackCoefficient/100);
 let extraRaw=(opt.defScale||0)*effDef(a,"reality");
 extraRaw+=(opt.speedScale||0)*effSpeed(a);
 let hpScale=(opt.hpScale||0);
 if(a.side==="player"&&state.deckId==="hp")hpScale*=.75;
 extraRaw+=hpScale*a.maxHp;
 extraRaw+=(opt.debuffScale||0)*bossDebuffCount();
 extraRaw+=(opt.bonus||0);
 raw+=extraRaw*tierScale;
 const mitigation=1000/(1000+effDef(t,type)*(1-pen)*Math.max(.15,defenseWeight));
 raw*=mitigation;
 raw=Math.max(10,raw);
 if(a.side==="player"&&state.deckId==="electric"&&a.index===0&&a.passiveFlag){raw*=1.35;a.passiveFlag=false;log(`${unitLabel(a)} 패시브 발동.`)}
 if(state.deckId==="execute"&&a.side==="player"&&a.index===0&&t.side==="enemy"){
   const rb=raidBarState(state.score),remainPct=state.mode==="clear"?pct(t.hp,t.maxHp):(rb.inside===0?100:100-rb.inside/RAID_BAR_HP*100);
   if(remainPct<=25)raw*=1.25;
