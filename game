function previewSkillCoefficient(a,which){
 if(!state||!a||a.side!=="player")return null;
 const liveState=state,previousPreview=DAMAGE_PREVIEW;
 try{
   state=clone(liveState);
   const previewActor=actorById(a.id);
   if(!previewActor)return null;
   state.currentId=previewActor.id;state.over=false;
   if(which===1)previewActor.sp=Math.max(previewActor.sp,2);
   if(which===2)previewActor.energy=Math.max(previewActor.energy,ultEnergyRequirement(previewActor));
   DAMAGE_PREVIEW={attackCoefficient:0,effectCoefficient:0,defCoefficient:0,speedCoefficient:0,hpCoefficient:0,conditionCoefficient:0,fixedDamage:0,attackHits:0,effectHits:0,types:[],heals:[],shields:[],effects:[],taunts:[],changes:[],weight:1};
   const tracked=["resource","energy","sp","maxSp","enhanced","counterReady","evade","maxHp","hp","preventDeath"];
   const before=new Map(state.players.map(p=>[p.id,Object.fromEntries(tracked.map(k=>[k,Number(p[k]||0)]))]));
   useSkill(which,true);
   for(const p of state.players){
    const previous=before.get(p.id);if(!previous)continue;
    for(const key of tracked){const delta=Number(p[key]||0)-previous[key];if(delta)DAMAGE_PREVIEW.changes.push({targetId:p.id,targetIndex:p.index,targetSide:p.side,key,delta,resourceLabel:p.resourceLabel||"전용 자원"})}
   }
   return {...DAMAGE_PREVIEW}
 }catch(_){return null}
 finally{state=liveState;DAMAGE_PREVIEW=previousPreview}
}
