 return Math.round(s)
}
function critChance(u){let bonus=0;if(state&&u.side==="player"&&state.deckId==="wind"&&(state.shared?.wind||0)>=15)bonus+=20;if(state&&u.side==="player"&&state.deckId==="tree"&&u.index===1)bonus+=(state.shared?.tree||0)*6;return clamp(u.crit+buff(u,"critUp")+bonus,0,100)}
function critDmg(u){let bonus=0;if(state&&u.side==="player"&&state.deckId==="wind"&&u.index===0&&(state.shared?.wind||0)>=15)bonus+=25;if(state&&u.side==="player"&&state.deckId==="tree"&&u.index===1)bonus+=(state.shared?.tree||0)*10;return u.critDmg+buff(u,"critDmgUp")+bonus}
function lowestPlayer(){return alivePlayers().sort((a,b)=>a.hp/a.maxHp-b.hp/b.maxHp)[0]}
function randomPlayer(){const live=alivePlayers();return live.length?live[Math.floor(Math.random()*live.length)]:null}
function combatChance(percent){return DAMAGE_PREVIEW?false:Math.random()*100<percent}
function bossSingleTarget(){
 const live=alivePlayers(),taunters=live.filter(p=>(p.taunt||0)>0);
 if(!taunters.length)return randomPlayer();
 const strongest=Math.max(...taunters.map(p=>p.taunt));
