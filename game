 const width=viewport?viewport.width:window.innerWidth,height=viewport?viewport.height:window.innerHeight;
 const compact=width<=1200||height<=700,landscape=width>height;
 const scale=compact&&landscape?Math.min(1,width/900,height/500):1;
 document.documentElement.style.setProperty("--mobile-game-scale",String(Math.max(.25,scale)));
}
function requestMobileLandscape(){
 const touchDevice=navigator.maxTouchPoints>0||matchMedia("(hover:none) and (pointer:coarse)").matches;
 if(!touchDevice)return;
 syncMobileViewport();
 const lock=()=>{
  try{const result=screen.orientation&&screen.orientation.lock?screen.orientation.lock("landscape"):null;if(result&&result.catch)result.catch(()=>{});setTimeout(syncMobileViewport,120)}catch(_){}
 };
 if(document.fullscreenElement||document.webkitFullscreenElement){lock();return}
 const root=document.documentElement,enter=root.requestFullscreen||root.webkitRequestFullscreen;
 if(!enter){lock();return}
 try{const result=enter.call(root);if(result&&result.then)result.then(lock).catch(()=>{});else lock()}catch(_){lock()}
