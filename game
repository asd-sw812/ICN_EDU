function nextRank(score){return [...RAID_RANKS].reverse().find(x=>x.min>score)||null}
function readRaidRecords(){
 try{const saved=localStorage.getItem(RAID_RECORD_KEY),records=saved?JSON.parse(saved):{};return records&&typeof records==="object"?records:{}}catch(_){return {}}
}
function raidRecordKey(bossId,deckId=selectedDeckId){return `${bossId}:${deckId}`}
function getRaidRecord(bossId,deckId=selectedDeckId){
 const records=readRaidRecords(),specific=records[raidRecordKey(bossId,deckId)];
 if(specific)return specific;
 const legacy=records[bossId];
 return legacy&&legacy.deckId===deckId?legacy:null
}
function bestScoreText(bossId,deckId=selectedDeckId){const record=getRaidRecord(bossId,deckId);return record?`${Number(record.score||0).toLocaleString()}점`:"기록 없음"}
function commitRaidRecord(){
 if(!state||state.recorded)return {isNew:false,record:getRaidRecord(state&&state.boss&&state.boss.bossId)};
 state.recorded=true;
 const records=readRaidRecords(),bossId=state.boss.bossId,key=raidRecordKey(bossId,state.deckId),previous=getRaidRecord(bossId,state.deckId);
 const isNew=!previous||state.score>Number(previous.score||0);
 if(isNew){
  const rank=scoreRank(state.score);
  records[key]={score:state.score,rank:rank.name,deckId:state.deckId,deckName:deck().name,updatedAt:Date.now()};
  try{localStorage.setItem(RAID_RECORD_KEY,JSON.stringify(records))}catch(_){}
 }
 return {isNew,record:isNew?records[key]:previous};
}
function raidBarState(score){
 const cleared=Math.floor(score/RAID_BAR_HP);
 const inside=score%RAID_BAR_HP;
 return {cleared,inside,remain:inside===0?100:100-inside/RAID_BAR_HP*100,current:RAID_BAR_COLORS[cleared%RAID_BAR_COLORS.length],next:RAID_BAR_COLORS[(cleared+1)%RAID_BAR_COLORS.length]}
}
function raidResult(){
 const rank=scoreRank(state.score);
 const saved=commitRaidRecord();
 state.over=true;
 showResult(rank.name,`<b>${state.score.toLocaleString()}점</b><br>${deck().name} · 전투 사이클 ${state.roundsCompleted}/${RAID_TURN_LIMIT}${saved.isNew?`<br><strong class="new-record">NEW DECK BEST</strong>`:`<br>이 덱 최고 기록 ${bestScoreText(state.boss.bossId)}`}`);
}
function readClearRecords(){
 try{const saved=localStorage.getItem(CLEAR_RECORD_KEY),records=saved?JSON.parse(saved):{};return records&&typeof records==="object"?records:{}}catch(_){return {}}
}
function getClearRecord(bossId){return readClearRecords()[bossId]||null}
function clearRecordText(bossId){
 const record=getClearRecord(bossId);
 return record?`${Number(record.turns||0)}턴 · ${Number(record.actions||0)}행동`:"기록 없음"
}
function clearTurnsUsed(){return state?state.roundsCompleted+1:0}
function commitClearRecord(){
 if(!state||state.recorded)return {isNew:false,record:getClearRecord(state&&state.boss&&state.boss.bossId)};
 state.recorded=true;
 const records=readClearRecords(),bossId=state.boss.bossId,previous=records[bossId];
 const turns=clearTurnsUsed(),actions=state.playerActions||0;
 const isNew=!previous||turns<Number(previous.turns||Infinity)||(turns===Number(previous.turns||Infinity)&&actions<Number(previous.actions||Infinity));
 if(isNew){
  records[bossId]={turns,actions,deckId:state.deckId,deckName:deck().name,updatedAt:Date.now()};
  try{localStorage.setItem(CLEAR_RECORD_KEY,JSON.stringify(records))}catch(_){}
 }
 return {isNew,record:isNew?records[bossId]:previous}
}

function bossProfile(){return BOSSES.find(x=>x.id===selectedBossId)||BOSSES[0]}
function attackTypeLabel(t){return t==="mental"?"정신피해":t==="reality"?"현실피해":"혼합"}
function elementMult(a,d){
 if(!a||!d||a===d)return 1;
 if((a==="이성"&&d==="본능")||(a==="본능"&&d==="이성"))return 1.25;
 const r=ELEMENT_REL[a];
 if(r&&r.strong===d)return 1.25;
 if(r&&r.weak===d)return .75;
 return 1
}
function matchupText(a,d){
 const m=elementMult(a,d);
 if(m>1)return `<span class="matchup-good">유리 x${m.toFixed(2)}</span>`;
 if(m<1)return `<span class="matchup-bad">불리 x${m.toFixed(2)}</span>`;
 return `<span class="matchup-neutral">중립</span>`
}

function showDamagePop(amount,opt={}){
 const layer=document.getElementById("damagePopLayer");
 if(!layer||!amount)return;
 if(document.body.classList.contains("vfx-edition")){Math.random();return;}
 const el=document.createElement("span");
 el.className="damage-pop"+(opt.crit?" crit":"")+(opt.groggy?" groggy":"")+(opt.dot?" dot":"");
 el.textContent=(opt.crit?"CRIT ":"")+Math.round(amount).toLocaleString()+(opt.groggy?"  x2":"");
 el.style.marginLeft=((Math.random()-.5)*150)+"px";
 layer.appendChild(el);
 setTimeout(()=>el.remove(),950)
}
function registerBossDamage(amount,staggerAmount=amount){
 if(!state||!state.boss||(amount<=0&&staggerAmount<=0))return;
 const b=state.boss;
 state.score+=Math.max(0,Math.round(amount));
 if(b.staggered)return;
 b.stagger=Math.min(b.staggerMax,b.stagger+Math.max(0,Math.round(staggerAmount)));
 if(b.stagger>=b.staggerMax){
   b.stagger=b.staggerMax;
   b.staggered=true;
   log(`[그로기] ${unitLabel(b)} 붕괴! 다음 행동 전까지 받는 피해 x${b.staggerMultiplier.toFixed(1)}.`);
 }
}
function bossSpecialOnPlayerHit(applied,source,oldShield){
 if(!state||!state.boss||applied<=0)return;
 const b=state.boss;
 if(b.bossId==="warden"&&oldShield>0&&b.shield===0){
   b.stagger=Math.min(b.staggerMax,b.stagger+260);
   addBuff(b,"vulnerable",18,1);
   log(`[봉인 파괴] 그로기 +260, 취약 18%.`);
   if(b.stagger>=b.staggerMax&&!b.staggered){b.staggered=true;log(`[그로기] ${unitLabel(b)} 붕괴!`)}
 }
 if(b.bossId==="devourer"){
   b.rage=(b.rage||0)+1;
   if(b.rage>=8){
     b.rage=0;addBuff(b,"atkUp",14,2);
     log(`[포식 본능] 연속 피격 누적: 공격력 상승.`);
   }
 }
}

